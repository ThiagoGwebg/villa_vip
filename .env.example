# ============================================================================
#  Catálogo Villa Vip Country Store — variáveis de ambiente
#  Copie para .env e preencha. Nunca commite .env.
# ============================================================================

# Supabase (Project Settings → API)
#   URL do projeto e SERVICE_ROLE key — o backend ignora RLS quando precisa,
#   por isso a key SERVICE_ROLE (não a anon). Mantenha em segredo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=eyJhbGciOi...sua-service-role-key

# Opcional — bucket de imagens de produto (default: product-images)
PRODUCT_IMAGES_BUCKET=product-images

# Opcional — só em dev local. Em produção (Vercel) ignorados.
PORT=3000
HOST=0.0.0.0
