# =============================================================================
#  Variáveis de ambiente — Catálogo Villa Vip Country Store
#
#  Copie este arquivo para .env (dev local) e configure as mesmas variáveis
#  no painel da Vercel (Settings → Environment Variables) para produção.
# =============================================================================

# URL do projeto Supabase. Encontrada em: Project Settings → API → Project URL.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role do Supabase (NÃO a anon).
# Encontrada em: Project Settings → API → Project API keys → service_role.
# ATENÇÃO: tem privilégios totais, nunca exponha no front nem comite no Git.
SUPABASE_KEY=

# Bucket do Supabase Storage que guarda as imagens de produto.
# Criado automaticamente por db/products.sql.
PRODUCT_IMAGES_BUCKET=product-images

# Porta do servidor em dev local (em produção, a Vercel ignora).
PORT=3000
